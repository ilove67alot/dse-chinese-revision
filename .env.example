# Environment variables the site reads. On Vercel, set them in Project Settings → Environment Variables.
# Locally: cp .env.example .env, fill it in, then `set -a; . ./.env; set +a` before `php -S` (never commit .env).
# Supabase dashboard → Project Settings → API (or "Connect").
SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon / publishable key. Do NOT use the service_role / secret key here.
SUPABASE_ANON_KEY=
