{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/(api/_lib|data|supabase|scripts)(/.*)?", "status": 404 },
    { "src": "/(router\\.php|README\\.md|\\.env.*)", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/(fanwen|flashcards|quiz|practice|writing)(?:\\.php)?/?", "dest": "/api/$1.php" }
  ]
}
